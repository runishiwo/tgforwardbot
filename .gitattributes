# 统一使用 LF，避免在 Linux 上运行 shell 脚本 / Python 时因 CRLF 出错
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# 二进制资源：不要做行尾/编码转换（内嵌字体）
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
